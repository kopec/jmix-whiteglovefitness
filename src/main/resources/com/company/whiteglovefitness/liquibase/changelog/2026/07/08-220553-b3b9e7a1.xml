    </changeSet>
    <changeSet id="2" author="WhiteGloveFitness">
        <createIndex indexName="IDX_EQUIPMENT_PROCEDURE_CHECKLIST_ITEM_EQUIPMENT_PROCEDURE"
                     tableName="EQUIPMENT_PROCEDURE_CHECKLIST_ITEM">
            <column name="EQUIPMENT_PROCEDURE_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="EQUIPMENT_PROCEDURE_ID"
                                 baseTableName="EQUIPMENT_PROCEDURE_CHECKLIST_ITEM"
                                 constraintName="FK_EQUIPMENT_PROCEDURE_CHECKLIST_ITEM_ON_EQUIPMENT_PROCEDURE"
                                 onDelete="CASCADE" referencedColumnNames="ID"
                                 referencedTableName="EQUIPMENT_PROCEDURE"/>
    </changeSet>
</databaseChangeLog>