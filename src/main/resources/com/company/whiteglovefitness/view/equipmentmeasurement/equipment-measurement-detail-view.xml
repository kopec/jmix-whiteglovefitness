<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://equipmentMeasurementDetailView.title"
      focusComponent="form">
    <data>
        <instance id="equipmentMeasurementDc"
                  class="com.company.whiteglovefitness.entity.EquipmentMeasurement">
            <fetchPlan extends="_base"/>
            <loader id="equipmentMeasurementDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="equipmentMeasurementDc">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
                <responsiveStep minWidth="40em" columns="2"/>
            </responsiveSteps>
            <select id="measurementTypeField" property="measurementType"/>
            <textField id="noteField" property="note"/>
            <textField id="valueField" property="value"/>
            <select id="measurementUnitField" property="measurementUnit"/>
        </formLayout>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveCloseAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
