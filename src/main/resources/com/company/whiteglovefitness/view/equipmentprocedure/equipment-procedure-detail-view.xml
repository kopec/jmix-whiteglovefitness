<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://equipmentProcedureDetailView.title"
      focusComponent="form">
    <data>
        <instance id="equipmentProcedureDc"
                  class="com.company.whiteglovefitness.entity.EquipmentProcedure">
            <fetchPlan extends="_base">
                <property name="equipmentProcedureVariant" fetch="JOIN" fetchPlan="_instance_name"/>
                <property name="equipmentProcedureChecks" fetch="BATCH" fetchPlan="_base"/>
                <property name="equipmentFiles" fetch="BATCH" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="equipmentProcedureDl"/>
            <collection id="equipmentProcedureChecksDc" property="equipmentProcedureChecks"/>
            <collection id="equipmentFilesDc" property="equipmentFiles"/>
        </instance>
        <collection id="equipmentProcedureVariantsDc"
                    class="com.company.whiteglovefitness.entity.EquipmentProcedureVariant">
            <fetchPlan extends="_instance_name"/>
            <loader id="equipmentProcedureVariantsDl" readOnly="true">
                <query>
                    <![CDATA[select e from EquipmentProcedureVariant e order by e.name]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="equipmentProcedureDc">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
                <responsiveStep minWidth="40em" columns="2"/>
            </responsiveSteps>
            <select id="equipmentProcedureTypeField" property="equipmentProcedureType"/>
            <entityComboBox id="equipmentProcedureVariantField"
                            property="equipmentProcedureVariant"
                            itemsContainer="equipmentProcedureVariantsDc">
                <actions>
                    <action id="entityLookupAction" type="entity_lookup"/>
                    <action id="entityClearAction" type="entity_clear"/>
                </actions>
            </entityComboBox>
            <textField id="noteField" property="note"/>
            <textField id="estimatedMinutesField" property="estimatedMinutes"/>
            <markdownEditor id="instructionsField" colspan="2" property="instructions" height="40em"/>
        </formLayout>
        <h4 text="msg://com.company.whiteglovefitness.entity/EquipmentProcedure.equipmentProcedureChecks"/>
        <hbox id="equipmentProcedureChecksButtonsPanel" wrap="true" width="100%">
            <button action="equipmentProcedureChecksDataGrid.createAction"/>
            <button action="equipmentProcedureChecksDataGrid.editAction"/>
            <button action="equipmentProcedureChecksDataGrid.removeAction"/>
        </hbox>
        <dataGrid id="equipmentProcedureChecksDataGrid" dataContainer="equipmentProcedureChecksDc" width="100%"
                  minHeight="20em">
            <actions>
                <action id="createAction" type="list_create">
                    <properties>
                        <property name="openMode" value="DIALOG"/>
                    </properties>
                </action>
                <action id="editAction" type="list_edit">
                    <properties>
                        <property name="openMode" value="DIALOG"/>
                    </properties>
                </action>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns>
                <column property="statement" autoWidth="true"/>
            </columns>
        </dataGrid>
        <h4 text="msg://com.company.whiteglovefitness.entity/EquipmentProcedure.equipmentFiles"/>
        <hbox id="equipmentFilesButtonsPanel" wrap="true" width="100%">
            <button action="equipmentFilesDataGrid.createAction"/>
            <button action="equipmentFilesDataGrid.editAction"/>
            <button action="equipmentFilesDataGrid.removeAction"/>
        </hbox>
        <dataGrid id="equipmentFilesDataGrid" dataContainer="equipmentFilesDc" width="100%"
                  minHeight="20em">
            <actions>
                <action id="createAction" type="list_create">
                    <properties>
                        <property name="openMode" value="DIALOG"/>
                    </properties>
                </action>
                <action id="editAction" type="list_edit">
                    <properties>
                        <property name="openMode" value="DIALOG"/>
                    </properties>
                </action>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns>
                <column property="fileType" autoWidth="true"/>
                <column property="fileRef" autoWidth="true"/>
                <column property="title" autoWidth="true"/>
            </columns>
        </dataGrid>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveCloseAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
