<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://equipmentModelListView.title"
      focusComponent="equipmentModelsDataGrid">
    <data>
        <collection id="equipmentModelsDc"
                    class="com.company.whiteglovefitness.entity.EquipmentModel">
            <fetchPlan extends="_base">
                <property name="equipmentBrand" fetch="JOIN" fetchPlan="_base"/>
                <property name="equipmentCategory" fetch="JOIN" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="equipmentModelsDl" readOnly="true">
                <query>
                    <![CDATA[select e from EquipmentModel e]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <genericFilter id="genericFilter"
                       dataLoader="equipmentModelsDl">
            <properties include=".*"/>
        </genericFilter>
        <hbox id="buttonsPanel" wrap="true" width="100%">
            <startSlot>
                <button id="createButton" action="equipmentModelsDataGrid.createAction"/>
                <button id="editButton" action="equipmentModelsDataGrid.editAction"/>
                <button id="referenceButton" text="msg://referenceButton.text"/>
                <button id="removeButton" action="equipmentModelsDataGrid.removeAction"/>
            </startSlot>
            <endSlot>
                <simplePagination id="pagination" dataLoader="equipmentModelsDl"/>
            </endSlot>
        </hbox>
        <dataGrid id="equipmentModelsDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="equipmentModelsDc"
                  columnReorderingAllowed="true">
            <actions>
                <action id="createAction" type="list_create"/>
                <action id="editAction" type="list_edit"/>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns resizable="true">
                <column property="name"/>
                <column property="modelNumber"/>
                <column property="equipmentBrand"/>
                <column property="equipmentCategory"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
